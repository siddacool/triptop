{
  "name": "triptop",
  "version": "5.22.5",
  "type": "module",
  "description": "Simple, offline travel budgeting app",
  "homepage": "https://triptop.siddheshmangela.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddacool/triptop.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "check": "pnpm run svelte-check && eslint . && pnpm run lint",
    "check:fix": "pnpm run svelte-check && eslint . && pnpm run format",
    "test:unit": "vitest",
    "test": "pnpm run test:unit --run",
    "storybook": "storybook dev -p 6006"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "10.5.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.102.0",
    "storybook": "10.5.8",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@flightlesslabs/currency": "^0.2.1",
    "@flightlesslabs/dodo-ui": "^0.36.14",
    "@flightlesslabs/dodo-ui-bits": "^0.11.8",
    "@flightlesslabs/dodo-ui-date": "^0.4.39",
    "@flightlesslabs/dodo-ui-numeric": "^0.2.36",
    "@iconify/svelte": "^5.2.2",
    "@internationalized/date": "^3.12.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "bits-ui": "^2.18.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "nanoid": "^6.0.1",
    "svelte-number-format": "^2.0.0"
  }
}
